{
  "debug": true,
  "port": 6001,
  "host": "0.0.0.0",
  "cors": {
    "origin": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": ["*"]
  },
  "ssl": {
    "enabled": false
  },
  "appManager": {
    "driver": "array",
    "cache": {
      "enabled": false
    },
    "array": {
      "apps": [
        {
          "id": "app-id",
          "key": "app-key",
          "secret": "app-secret",
          "maxConnections": 1000,
          "enableClientMessages": true,
          "enabled": true,
          "maxBackendEventsPerSecond": 1000,
          "maxClientEventsPerSecond": 1000,
          "maxReadRequestsPerSecond": 1000,
          "webhooks": [],
          "enableAuthorization": true,
          "enableUserAuthentication": false
        }
      ]
    }
  }
}
